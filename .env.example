# fystrm 配置（生产 .env 不要提交到 git）

# ====== App ======
HOST=0.0.0.0
PORT=8095
DEBUG=false
SECRET_KEY=change-me-to-random-string

# ====== Database ======
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fystrm
POSTGRES_PASSWORD=fystrm_pwd_change_me
POSTGRES_DB=fystrm

# ====== Redis ======
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ====== TMDB ======
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN

# ====== Emby ======
EMBY_URL=
EMBY_API_KEY=

# ====== Logging ======
LOG_LEVEL=INFO

# CD2 webhook 鉴权 token (跟 CD2 toml authorization 一致)
CD2_WEBHOOK_TOKEN=

CD2_MOUNT_ROOT=/mnt/CloudNAS
